   },
   "blocks": [
    {
     "type": "paragraph",
     "rich": [
      {
       "text": "If you misplace your card, freeze it straight away. Nobody can use it while it is frozen, and you can unfreeze it at any time."
      }
     ]
    },
    {
     "type": "heading_1",
     "rich": [
      {
       "text": "Freeze your card in the app"
      }
     ]
    },
    {
     "type": "numbered_list_item",
     "rich": [
      {
       "text": "Open the Northwind app and tap "
      },
      {
       "text": "Cards",
       "bold": true
      }
     ]
    },
    {
     "type": "numbered_list_item",
     "rich": [
      {
       "text": "Choose the card"
      }
     ]
    },
    {
     "type": "numbered_list_item",
     "rich": [
      {
       "text": "Turn on "
      },
      {
       "text": "Freeze card",
       "bold": true
      }
     ]
    },
    {
     "type": "callout",
     "rich": [
      {
       "text": "If you think your card was stolen, call us on 1-800-555-0100 instead. We will cancel it and send a new one."
      }
