{
  "name": "ew-shareready",
  "private": true,
  "version": "0.1.0",
  "description": "ShareReady: social and search link previews, checks and one-click fixes for Experience Workspace (AEM Edge Delivery Services)",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\" \"tools/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/ tools/reviewloop/test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vipult2022/ew-shareready.git"
  },
  "author": "Vipul Tiwari",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/vipult2022/ew-shareready/issues"
  },
  "homepage": "https://github.com/vipult2022/ew-shareready#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.13",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "linkedom": "0.18.15",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  }
}
